*.sh text eol=lf
# 知识资产按字节做 SHA256 完整性校验，行尾必须固定为 LF，否则 Windows 检出会误报 KNOWLEDGE_ASSET_CONFLICT。
codeflow-docs/知识库/** text eol=lf
codeflow-docs/规格知识库/** text eol=lf
# 桌面内置资产按字节做 SHA256 完整性校验，跨平台必须固定 LF。
apps/desktop/client/assets/orchestration-builtin/** text eol=lf
apps/desktop/client/assets/orchestration-builtin.manifest.json text eol=lf
apps/server/tests/fixtures/orchestration/** text eol=lf
# SEO 生成物由 scripts/generate-site-seo.mjs 固定写 LF，避免 Windows 检出 CRLF 后构建产生假性修改。
apps/web/public/robots.txt text eol=lf
apps/web/public/sitemap.xml text eol=lf
apps/web/seo/public-urls.json text eol=lf
