{
  "name": "@codeflowai/web",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "seo:generate": "node ../../scripts/generate-site-seo.mjs",
    "seo:prerender": "node ../../scripts/generate-site-seo.mjs --prerender",
    "dev": "pnpm seo:generate && vite",
    "build": "pnpm seo:generate && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build && pnpm seo:prerender",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "vue-tsc -p tsconfig.test.json --noEmit",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.2.4",
    "@ant-design/icons-vue": "^7.0.1",
    "@codeflowai/shared": "workspace:*",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ant-design-vue": "^4.2.3",
    "d3": "^7.9.0",
    "dayjs": "^1.11.19",
    "elkjs": "^0.11.1",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.13.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode": "1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/d3": "^7.4.3",
    "@types/markdown-it": "^14.1.2",
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-vue": "^6.0.4",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vue-tsc": "^2.2.0"
  }
}
