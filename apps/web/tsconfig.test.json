{
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["src/*"],
      "@codeflowai/shared": ["../../packages/shared/src/index.ts"],
      "@codeflowai/shared/*": ["../../packages/shared/src/*"]
    }
  }
}
