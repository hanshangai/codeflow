{
  "name": "@codeflowai/client",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "codeflow": "bin/codeflow.js"
  },
  "engines": {
    "node": ">=22.16.0 <23 || >=24 <25"
  },
  "files": ["dist/", "bin/", "scripts/"],
  "scripts": {
    "dev": "node --env-file-if-exists=../../../env/.env --env-file-if-exists=../../../env/.env.local --conditions development --enable-source-maps --import tsx src/index.ts --foreground",
    "build": "tsc -p tsconfig.json --noEmit && node ../../../tools/release/clean-dist.cjs dist && node ./scripts/build-bundle.mjs",
    "postinstall": "node ./scripts/verify-bundled-native.mjs node-pty @napi-rs/keyring && node ./scripts/postinstall-prune.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "cfb": "1.2.2",
    "diff": "9.0.0",
    "node-pty": "1.1.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "ppt-codec": "2.2.23",
    "saxes": "5.0.1",
    "undici": "7.30.1",
    "unpdf": "1.9.1",
    "word-extractor": "1.0.4",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.70",
    "@anthropic-ai/sdk": "^0.78.0",
    "@codeflowai/shared": "workspace:*",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.27.3",
    "simple-git": "^3.27.0",
    "tsx": "^4.19.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.2"
  }
}
